			section.blog-layout#notes
				div.feed-column
					.feed-heading
						div
							p.section-eyebrow Research notes
							h2 Notes
							p(data-note-count data-total=`${noteCount}`) Showing #{noteCount} of #{noteCount} posts
						.feed-actions
							.note-view-toggle(aria-label="Note display mode")
								button(type="button" data-note-view="site") Concise
								button(type="button" data-note-view="image") Verbose
					if categories.length
						.category-strip(aria-label="Note categories")
							button(type="button" data-filter-value="") All
							each category in categories
								button(type="button" data-filter-value=`${category}`) #{category}
							button(type="button" data-filter-value="__archive" data-archive-filter) Archive
					.post-feed.note-view-site(data-note-feed)
						each note, index in notes
							- const image = note.image || note.cover || note.hero || note.thumbnail || ""
							- const hasImage = Boolean(image)
							- const noteId = `note-${index}`
							- const noteTags = (note.tags || []).join('|')
							- const noteExcerpt = stripExcerptMath(note.excerpt || '')
							- const readTime = Math.max(3, Math.ceil((noteExcerpt || note.title || '').length / 120))
							article.note-card-shell(data-note-shell)
								a.post-card.note-card(class=!hasImage ? "no-image" : null href=`#${noteId}` data-note-card data-note-open data-note-id=`${noteId}` data-note-key=`${note.url}` data-note-index=`${index}` data-note-url=`${note.url}` data-note-image=`${image}` data-note-archived=(note.archived || note.archive) ? "true" : "false" data-comment-term=`note:${note.url}` data-title=`${note.title}` data-tags=`${noteTags}` data-category=`${note.category || ''}` data-date=`${note.date || ''}` data-excerpt=`${noteExcerpt}` data-read-time=`${readTime}` style=hasImage ? `--card-image: url("${image}")` : null)
									if hasImage
										.post-art(aria-hidden="true")
									.post-content
										.post-meta
											span #{note.date || "Undated"}
										span #{note.category || "Note"}
										h3 #{note.title}
										if noteExcerpt
											p #{noteExcerpt}
										else
											p.muted Preserved Markdown note from the old site.
										.post-footer
											span.read-time #{readTime} min read
											if note.tags && note.tags.length
												span.tags-inline #{note.tags.slice(0, 2).join(" / ")}
									span.post-arrow(aria-hidden="true") >
								button.note-archive-toggle(type="button" data-note-archive data-note-key=`${note.url}` hidden) Archive
					p.empty-state#noteEmptyState(hidden) No matching notes.

