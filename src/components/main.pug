	  { label: "CV", zh: "简历", glyph: "PDF", href: profile.cv.en, cv: true, newTab: true },
	  { label: "Email", zh: "邮箱", icon: "email", href: "mailto:jchenkg@connect.ust.hk" },
	  { label: "Phone", zh: "电话", glyph: "TEL", href: "tel:+85256029402" }
	]
- const educationItems = profile.education
- const researchInterests = profile.research
- const publications = profile.publications
- const awards = profile.awards
- const contactItems = profile.contact


