.cat-companion(data-cat-companion data-state="idle" data-side="right" data-facing="left" role="group" aria-label="Mochi the interactive cat")
	button.cat-restore(type="button" data-cat-restore hidden aria-label="Show Mochi the cat")
		span(aria-hidden="true") 🐾
	.cat-panel(data-cat-panel)
		button.cat-menu-toggle(type="button" data-cat-menu aria-label="Show cat controls" aria-expanded="false" aria-controls="mochi-controls" title="Cat controls") ⋯
		button.cat-pet(type="button" data-cat-pet aria-label="Pet Mochi" aria-describedby="mochi-help" title="Pet Mochi · double-click to jump · drag to move")
			span.cat-sprite(data-cat-sprite aria-hidden="true")
		p.cat-bubble(data-cat-bubble hidden aria-live="polite")
		.cat-copy#mochi-controls(hidden)
			.cat-menu-heading
				strong Mochi
				button.cat-hide(type="button" data-cat-hide aria-label="Hide Mochi" title="Hide cat") ×
			p.cat-status(data-cat-status aria-live="polite") Your little research companion.
			.cat-actions
				button(type="button" data-cat-feed) Feed
				button(type="button" data-cat-play) Play
				button(type="button" data-cat-jump) Jump
				button(type="button" data-cat-nap aria-pressed="false") Nap
				button.cat-follow(type="button" data-cat-follow aria-pressed="false") Follow cursor
				button.cat-explore(type="button" data-cat-explore aria-pressed="true") Stay here
				button.cat-side(type="button" data-cat-side aria-label="Move Mochi to left side") Move left
			p.cat-help#mochi-help I explore window edges and peek around corners. Pet me, double-click to jump, or drag me to either side.
